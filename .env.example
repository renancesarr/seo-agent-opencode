# Configuracao local: docs/CHAVES-BUSCADORES.md.
# Copie para .env apenas se ele ainda nao existir. Nunca commite chaves reais.
# Valores com caracteres especiais devem ficar entre aspas simples.

# IMPLEMENTADO: segredo do SearXNG local (Docker Compose le .env).
# Gere com secrets.token_hex(32); nao e uma chave de buscador externo.
SEARXNG_SECRET=

# IMPLEMENTADO: Brave Search API (ativada quando a chave estiver preenchida).
# search-batch le .env automaticamente; variaveis exportadas tem prioridade.
BRAVE_SEARCH_API_KEY=

# APIs abaixo entram em search-batch somente com TODAS as credenciais preenchidas.
# Sem credenciais nao ha chamada HTTP nem tentativa de autenticar o provedor.

# Google Custom Search JSON API: somente clientes existentes elegiveis.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Yandex Search API: conta de servico e folder do Yandex Cloud.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Indices/servicos alternativos com API oficial.
MOJEEK_API_KEY=
KAGI_API_KEY=
YDC_API_KEY=

# Provedores terceiros de SERP (nao sao APIs oficiais Google/Bing/Yahoo).
SERPAPI_API_KEY=
SERPER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Bing, Yahoo, DuckDuckGo, Ecosia, Startpage e Qwant:
# veja as limitacoes no documento; nao ha chave generica configurada aqui.
