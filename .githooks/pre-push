#!/usr/bin/env bash
# Backstop final: valida a identidade REAL (autor E committer dos objetos)
# de todo commit novo empurrado para as branches de agente. Cobre qualquer
# bypass local (--author, env, merges, hooks pulados) porque inspeciona os
# commits que efetivamente vão para o remoto — não o ambiente.
# Isenção: SOMENTE histórico publicado do projeto (refs de origin/origin-codex,
# que apontam para o mesmo repo). Refs LOCAIS não publicadas não isentam nada
# (dev-ai/main locais não são histórico confiável) e remotos não relacionados
# tampouco. FAIL-CLOSED: se a enumeração falhar, o push é bloqueado.
remote="$1"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$GIT_HUMAN" = "1" ] && continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  case "$remote_ref" in
    refs/heads/zcode-ai) want_n="ai-zcode"; want_e="ai-zcode@users.noreply.github.com" ;;
    refs/heads/codex-ai) want_n="ai-codex"; want_e="261107596+Fencing3422@users.noreply.github.com" ;;
    *) continue ;;
  esac

  # Exclusão: apenas o que já está publicado em origin/origin-codex
  # (inclui a posição antiga da própria branch e os trunks main/dev-ai,
  # cobrindo bootstrap e commits herdados de dev-ai em merges de sincronização).
  excl=()
  while IFS= read -r r; do
    [ -n "$r" ] && excl+=("$r")
  done < <(git for-each-ref --format='%(refname)' refs/remotes/origin refs/remotes/origin-codex)

  if [ "${#excl[@]}" -gt 0 ]; then
    set -- "$local_sha" --not "${excl[@]}"
  else
    set -- "$local_sha"
  fi
  if ! revs=$(git rev-list "$@"); then
    echo "ERRO (pre-push): falha ao enumerar commits para $remote_ref — bloqueando por segurança (fail-closed)."
    exit 1
  fi

  for c in $revs; do
    IFS='|' read -r an ae cn ce <<< "$(git log -1 --format='%an|%ae|%cn|%ce' "$c")"
    if [ "$an" != "$want_n" ] || [ "$ae" != "$want_e" ] || [ "$cn" != "$want_n" ] || [ "$ce" != "$want_e" ]; then
      echo "ERRO (pre-push): commit com identidade incorreta indo para $remote_ref:"
      echo "  commit:    $c"
      echo "  autor:     $an <$ae>"
      echo "  committer: $cn <$ce>"
      echo "  exigido:   $want_n <$want_e> (autor E committer)"
      exit 1
    fi
  done
done
exit 0
